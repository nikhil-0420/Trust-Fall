{
  "additionalProperties": false,
  "properties": {
    "id": {
      "description": "Unique attack identifier, e.g. A01",
      "title": "Id",
      "type": "string"
    },
    "title": {
      "description": "Short attack name",
      "title": "Title",
      "type": "string"
    },
    "category": {
      "description": "Attack category e.g. direct, roleplay, obfuscation",
      "title": "Category",
      "type": "string"
    },
    "owasp": {
      "description": "OWASP category e.g. LLM01",
      "title": "Owasp",
      "type": "string"
    },
    "goal": {
      "description": "Target objective",
      "enum": [
        "leak",
        "poison",
        "refund"
      ],
      "title": "Goal",
      "type": "string"
    },
    "known": {
      "description": "True if part of standard library, False if held-out",
      "title": "Known",
      "type": "boolean"
    },
    "text": {
      "description": "Payload text <= 500 chars",
      "maxLength": 500,
      "title": "Text",
      "type": "string"
    },
    "steps": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional multi-step attack payload texts (up to 3)",
      "title": "Steps"
    },
    "archetype": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Attack archetype identifier",
      "title": "Archetype"
    },
    "l0_verified": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Whether attack was verified at L0",
      "title": "L0 Verified"
    },
    "stability": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Calibration stability e.g. 3/3",
      "title": "Stability"
    },
    "orig_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Original text if rewritten in Stage B",
      "title": "Orig Text"
    }
  },
  "required": [
    "id",
    "title",
    "category",
    "owasp",
    "goal",
    "known",
    "text"
  ],
  "title": "Attack",
  "type": "object"
}